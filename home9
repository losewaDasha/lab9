#define _CRT_SECURE_NO_WARNINGS
#include <stdio.h>
#include <locale.h>
#include <windows.h>

int main() {

    SetConsoleCP(1251);
    SetConsoleOutputCP(1251);
    setlocale(LC_ALL, "RUS");
    
    int a, b;
    char fill_char;
    const int offset = 5;

    printf("Введите длину вертикального катета a (целое число > 0): ");
    if (scanf("%d", &a) != 1 || a <= 0) {
        printf("Ошибка: введено некорректное значение для a.\n");
        return 1;
    }

    printf("Введите длину горизонтального катета b (целое число > 0): ");
    if (scanf("%d", &b) != 1 || b <= 0) {
        printf("Ошибка: введено некорректное значение для b.\n");
        return 1;
    }

    while (getchar() != '\n');

    printf("Введите символ для заполнения фигуры: ");
    scanf("%c", &fill_char);

    printf("\n--- Результат ---\n\n");

    for (int i = 0; i < a; i++) {

        for (int k = 0; k < offset; k++) {
            printf(" ");
        }

        int chars_to_print = (b * (i + 1)) / a;
        if (chars_to_print == 0) chars_to_print = 1;

        for (int j = 0; j < chars_to_print; j++) {
            printf("%c", fill_char);
        }

        printf("\n");
    }

    return 0;
}
